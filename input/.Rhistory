df <- read_excel("D:/分析软件/R/BBP处理数据.xlsx")
library(readxl)
library(dplyr)
library(psych)
library(nlme)
library(piecewiseSEM)
# ======================================================
# 读取数据
# ======================================================
df <- read_excel("D:/分析软件/R/BBP处理数据.xlsx")
# ======================================================
# 数据预处理：负值与检出限替换
# ======================================================
df$CaCl2[df$CaCl2 < 0.038] <- 0.038
df$Enzyme[df$Enzyme < 0.1185] <- 0.1185
df$HCl[df$HCl < 0] <- 0.1
df$Citric[df$Citric < 0] <- 0.1
View(df)
View(df)
write.csv(df,
"D:/分析软件/R/BBP处理数据_处理后.csv",
row.names = FALSE,
fileEncoding = "UTF-8")
library(readxl)
library(dplyr)
library(tidyr)
library(lubridate)
library(writexl)
# 安装需要的包（如果还没装的话）
install.packages(c("readxl", "dplyr", "tidyr", "writexl", "lubridate"))
install.packages(c("readxl", "dplyr", "tidyr", "writexl", "lubridate"))
# 1. 读入逐日数据 ----------------------------------------------------------
# 改成你自己的文件路径
daily <- read_xlsx("D:/model/FangxiuWan-TECO-CNP-Sv1.0-edff198/TECO-CNP Sv1.0 20250316/input/新建 Microsoft Excel 工作表")
# 1. 读入逐日数据 ----------------------------------------------------------
# 改成你自己的文件路径
daily <- read_xlsx("D:/model/FangxiuWan-TECO-CNP-Sv1.0-edff198/TECO-CNP Sv1.0 20250316/input/新建 Microsoft Excel 工作表.xlsx")
# 看一下结构（可选）
str(daily)
head(daily)
# 2. 单位转换：VPD kPa -> Pa；PAR mol m-2 d-1 -> μmol m-2 s-1 ----------
daily_conv <- daily %>%
mutate(
# VPD：kPa -> Pa
vpd_pa = vpd * 1000,   # 新列，单位 Pa
# PAR：假设原来是 mol m-2 d-1
# 转成 μmol m-2 s-1：1 mol = 1e6 μmol; 1 d = 86400 s
par_umol_m2_s = par * 1e6 / 86400
# par_umol_m2_s ≈ par * 11.57407
)
# 3. 逐日扩展为逐小时（每一天复制 24 行，hour = 0:23）-------------------
hourly <- daily_conv %>%
# 原来的 hour 列全是 NA，可以先删掉，重新生成
select(-hour) %>%
# 为每一行生成一个 0:23 的小时向量
mutate(hour = list(0:23)) %>%
# 展开 list 列，变成 24 行
unnest(hour) %>%
arrange(year, doy, hour)
# 4. （可选）生成真正的日期时间列 ----------------------------------------
hourly <- hourly %>%
mutate(
# 把 year + doy 变成 Date
date = as.Date(doy - 1, origin = paste0(year, "-01-01")),
# 再加上小时，得到 POSIXct
datetime = as.POSIXct(date) + hours(hour)
) %>%
# 调整一下列顺序（可自己改）
select(year, doy, date, hour, datetime,
tair, tsoil, rh,
vpd_pa,       # 新单位 Pa
rain, wind,
par_umol_m2_s,# 新单位 μmol m-2 s-1
co2)
# 5. 导出为新的 Excel（或 CSV）-------------------------------------------
write_xlsx(hourly, "he_shan_hourly_vpdPa_parUmol.xlsx")
View(hourly)
# 5. 导出为新的 Excel（或 CSV）-------------------------------------------
write_xlsx(hourly, "he_shan_hourly_vpdPa_parUmol.xlsx")
# 5. 导出为新的 Excel（或 CSV）-------------------------------------------
write.xlsx(hourly, "he_shan_hourly_vpdPa_parUmol.xlsx")
# 或者：
write.csv(hourly, "he_shan_hourly_vpdPa_parUmol.csv", row.names = FALSE)
# 或者：
write.csv(hourly, "D:/model/FangxiuWan-TECO-CNP-Sv1.0-edff198/TECO-CNP Sv1.0 20250316/input/he_shan_hourly_vpdPa_parUmol.csv", row.names = FALSE)
setwd("D:/model/FangxiuWan-TECO-CNP-Sv1.0-edff198/TECO-CNP Sv1.0 20250316/input")
library(data.table)
library(dplyr)
## 1. 读入逐日数据 -----------------
## 假设列名类似：
## year, doy, Tair, Tsoil, RH, VPD, Rain, WS, PAR, CO2
## （没有 hour 列）
daily <- fread("D:/model/FangxiuWan-TECO-CNP-Sv1.0-edff198/TECO-CNP Sv1.0 20250316/input/新建 Microsoft Excel 工作表.csv")  # 换成你的逐日文件路径
## 2. 指定哪些变量是“日总量”，要均分到 24 小时 ----
## 目前只把降水当作“日累积量示例”
sum_vars <- c("Rain")
n_hours  <- 24L
n_days   <- nrow(daily)
## 检查 sum_vars 是否都在数据里（防止写错列名）
missing_cols <- setdiff(sum_vars, names(daily))
if (length(missing_cols) > 0) {
stop("下面这些列在 daily 数据里找不到：",
paste(missing_cols, collapse = ", "))
}
## 3. 按天复制 24 次，生成逐小时数据 -----------
## 每一行（日） -> 24 行（小时）
hourly <- daily[rep(seq_len(n_days), each = n_hours)]
## 新增 hour 列：1–24，而不是 0–23
hourly[, hour := rep(1:n_hours, times = n_days)]
## 4. 把“日总量”均分到 24 小时 -----------------
## 例如：日雨量 24 mm -> 每小时 1 mm
for (v in sum_vars) {
hourly[[v]] <- hourly[[v]] / n_hours
}
## 5. 按 TECO forcing 需要的顺序整理列 ----------
## 如果你的 daily 没有 year / doy，请相应修改这里
cols_order <- c("year", "doy", "hour",
"Tair", "Tsoil", "RH", "VPD",
"Rain", "WS", "PAR", "CO2")
## 保证这些列都存在
missing_force <- setdiff(cols_order, names(hourly))
if (length(missing_force) > 0) {
stop("下面这些强迫变量列在 hourly 数据里找不到：",
paste(missing_force, collapse = ", "))
}
setcolorder(hourly, cols_order)
## 6. 导出为 TECO 使用的 forcing 文件 ----------
## TECO 使用 Fortran 自带读入，只要空白分隔即可；
## 用制表符更清楚一点
fwrite(
hourly,
file      = "ForTECOSpinup_2001.txt",  # 输出文件名，按需要改
sep       = "\t",
col.names = TRUE
)
cat("已生成逐小时 forcing 文件: ForTECOSpinup_2001.txt\n")
