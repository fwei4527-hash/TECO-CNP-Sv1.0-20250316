"温带草原区域" = "TG",
"青藏高原高寒植被区域" = "QTAR",
"亚热带常绿阔叶林区域" = "SBF",
"热带季风雨林、雨林区域" = "TR",
"暖温带落叶阔叶林区域" = "WTBF",
"温带针叶、落叶阔叶混交林" = "TMF",
"寒温带针叶林区域" = "CTCF"
)
# 检查是否有未翻译的区域
if (!all(unique(shp_data$区域[!is.na(shp_data$区域)]) %in% names(translation))) {
warning("Some region names are not translated. Please update the translation vector.")
}
# 过滤 NA 并将区域列转换为英文简写
shp_data <- shp_data %>%
filter(!is.na(区域)) %>%
mutate(区域 = factor(区域, levels = names(translation), labels = translation))
# 设置区域属性列
attribute_column <- "区域"
# 检查属性列是否存在
if (!(attribute_column %in% names(shp_data))) {
stop("指定的区域列 '", attribute_column, "' 不存在。可用列：", paste(names(shp_data), collapse = ", "))
}
# 确保 shapefile 和采样点的 CRS 与 GeoJSON 一致
shp_data <- st_transform(shp_data, crs = 4326)
locations_sf <- st_transform(locations_sf, crs = 4326)
# 定义自定义颜色
custom_colors <- c(
"TD" = "#F4DBB2",    # 淡褐色
"TG" = "#FDD378",    # 浅绿色
"QTAR" = "#FFD47F",  # 浅蓝色
"SBF" = "#228B22",   # 森林绿
"TR" = "#006400",    # 深绿色
"WTBF" = "#8FBC8F",  # 深海绿
"TMF" = "#4C9BE6",   # 深橄榄绿
"CTCF" = "#87CEEB"   # 海绿色
)
# 创建主地图
main_map <- ggplot() +
# 绘制区域划分（按区域列着色）
geom_sf(data = shp_data, aes(fill = .data[[attribute_column]]), color = "white", linewidth = 0.25, alpha = 0.7) +
scale_fill_manual(values = custom_colors, name = "Legend") +  # 使用自定义颜色，图例标题为“Legend”
# 绘制中国地图边界
geom_sf(data = geojson_data, fill = NA, color = "black", size = 0.5) +
# 绘制采样点
geom_sf(data = locations_sf, color = "red", size = 3) +
# 添加采样点标签
geom_text_repel(
data = locations, aes(x = Longitude, y = Latitude, label = Site),
size = 6, fontface = "bold", color = "black",
box.padding = 0.5, point.padding = 0.3, segment.color = "black",
position = position_nudge(x = 0.3, y = 0.3)
) +
coord_sf(xlim = c(73, 136), ylim = c(17, 54), expand = FALSE) +
scale_x_continuous(breaks = seq(70, 140, by = 20)) +
scale_y_continuous(breaks = seq(20, 50, by = 10)) +
theme_minimal() +
theme(
panel.background = element_rect(fill = "white", color = "white"),
panel.border = element_rect(color = "black", fill = NA, size = 1),
panel.grid.major = element_line(color = "gray80", size = 0.5),
axis.ticks.length = unit(0.3, "cm"),
axis.text = element_text(size = 15, face = "bold", color = "black"),
legend.position = c(0.1, 0.0),  # 图例位于右下角（南海插图上方）
legend.justification = c(0.5, 0),
legend.box.margin = margin(0, 0, 0, 0),
legend.title = element_text(size = 14, face = "bold"),
legend.text = element_text(size = 12)
) +
annotation_scale(location = "tl", width_hint = 0.2, text_cex = 1.2, text_face = "bold",
line_col = "black", text_col = "black") +
annotation_north_arrow(location = "tr", which_north = "true",
style = north_arrow_fancy_orienteering,
height = unit(2, "cm"), width = unit(2, "cm"))
# 创建插图（南海区域，包含区域划分）
inset_map <- ggplot() +
geom_sf(data = shp_data, aes(fill = .data[[attribute_column]]), color = "white", linewidth = 0.25, alpha = 0.7) +
scale_fill_manual(values = custom_colors, name = "Legend", guide = "none") +  # 使用自定义颜色，不显示图例
geom_sf(data = geojson_data, fill = NA, color = "black", size = 0.2) +
coord_sf(xlim = c(108, 123), ylim = c(4, 23), expand = FALSE) +
theme_void() +
theme(
panel.background = element_rect(fill = "white", color = "black")
)
# 组合主地图和插图
final_plot <- ggdraw() +
draw_plot(main_map, 0, 0, 1, 1) +
draw_plot(inset_map, 0.8, 0.2, 0.2, 0.2)
# 显示最终地图
print(final_plot)
# 保存地图为 PNG 文件
ggsave("D:/分析软件/R/R结果/China_Regions_Sites_Map.png", final_plot, width = 10, height = 8, dpi = 300, bg = "white")
cat("可视化图像已保存至：D:/分析软件/R/R结果/China_Regions_Sites_Map.png\n")
# 加载必要的 R 包
library(sf)        # 用于读取和处理 shapefile
library(ggplot2)   # 用于可视化
library(cowplot)   # 用于组合主地图和插图
library(ggspatial) # 用于比例尺和北箭头
library(ggrepel)   # 用于采样点标签
library(dplyr)     # 用于数据处理
library(readxl)    # 用于读取 Excel 文件（可选）
# 定义采样点名称和经纬度
site_names <- c("AME", "MES", "CD", "HG", "TM", "CS", "DH", "MX", "JF")
locations <- data.frame(
Site = site_names,
Latitude = c(52.97210, 45.30000, 40.97000, 33.50000, 30.35000, 28.40000, 23.16670, 21.46670, 18.71670),
Longitude = c(122.51300, 127.60000, 117.93000, 108.40000, 119.45000, 113.20000, 112.55000, 101.56670, 108.86670)
)
# 将采样点转换为 sf 对象
locations_sf <- st_as_sf(locations, coords = c("Longitude", "Latitude"), crs = 4326)
# 读取中国地图的 GeoJSON 文件
geojson_data <- st_read("D:/分析软件/R/中华人民共和国 (1).json")
geojson_data <- st_make_valid(geojson_data)
# 读取区域划分 shapefile
shp_path <- "D:/分析软件/R/quhua/vegzone_alb54.shp"
if (!file.exists(shp_path)) {
stop("Shapefile 未找到，请检查路径：", shp_path)
}
# 检查其他相关文件（.shx, .dbf）
shx_path <- sub("\\.shp$", ".shx", shp_path)
dbf_path <- sub("\\.shp$", ".dbf", shp_path)
if (!file.exists(shx_path) || !file.exists(dbf_path)) {
warning("缺少 .shx 或 .dbf 文件，尝试设置 SHAPE_RESTORE_SHX=YES 修复。")
Sys.setenv(SHAPE_RESTORE_SHX = "YES")
}
# 读取 shapefile
tryCatch({
shp_data <- read_sf(shp_path)
}, error = function(e) {
stop("读取 shapefile 失败：", e$message, "\n请确保 .shp、.shx 和 .dbf 文件都在 D:/分析软件/R/quhua/ 目录下且未损坏。")
})
# 检查 shapefile 的基本信息
cat("Shapefile 摘要信息：\n")
print(summary(shp_data))
cat("坐标参考系 (CRS)：\n")
print(st_crs(shp_data))
cat("可用属性列：\n")
print(names(shp_data))
cat("区域列的唯一值：\n")
print(unique(shp_data$区域))
# 定义中文到英文简写的翻译
translation <- c(
"温带荒漠区域" = "TD",
"温带草原区域" = "TG",
"青藏高原高寒植被区域" = "QTAR",
"亚热带常绿阔叶林区域" = "SBF",
"热带季风雨林、雨林区域" = "TR",
